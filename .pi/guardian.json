{
  "binary": "guardian",
  "globalArgs": [],
  "createArgs": [
    "--gvisor-overlay2=none",
    "--mount",
    "type=bind,source=$(pwd),destination=$(pwd)",
    "--mount",
    "type=bind,source=/home/ash/.pi,destination=/home/ash/.pi,ro=true",
    "--mount",
    "type=bind,source=$(pwd)/.git,destination=$(pwd)/.git,ro=true"
  ],
  "startArgs": [
    "--net-policy",
    ".pi/net-policy.toml"
  ],
  "cleanup": "keep",
  "allow_no_sandbox": true
}
